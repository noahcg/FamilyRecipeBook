# Supabase — from your project's API settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-only, never expose to the browser
# Used to bypass RLS for privileged operations (e.g. accepting invitations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare Workers AI — server-only, used for pantry-based recipe ideas
# Get these from Cloudflare Dashboard → Workers AI → Use REST API
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_WORKERS_AI_API_TOKEN=your-workers-ai-token
# Optional global rollback pin. Leave unset to use task-specific registry defaults.
# CLOUDFLARE_WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# Optional task-specific overrides. Values must be in the server allowlist.
# CLOUDFLARE_RECIPE_GENERATION_MODEL=@cf/google/gemma-4-26b-a4b-it
# No automatic generation fallback is configured; use the primary override above for manual rollback.
# CLOUDFLARE_RECIPE_DESCRIPTION_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# CLOUDFLARE_RECIPE_DESCRIPTION_FALLBACK_MODEL=@cf/google/gemma-4-26b-a4b-it
# CLOUDFLARE_RECIPE_IMAGE_SEARCH_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# CLOUDFLARE_RECIPE_IMAGE_SEARCH_FALLBACK_MODEL=@cf/google/gemma-4-26b-a4b-it
# CLOUDFLARE_RECIPE_IMAGE_RANKING_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# CLOUDFLARE_RECIPE_IMAGE_RANKING_FALLBACK_MODEL=@cf/google/gemma-4-26b-a4b-it
# Avoid a global fallback when task primaries differ: matching a task primary disables its fallback.
# Prefer the task-specific fallback variables above.
# ENABLE_AI_IMAGE_PICKER=false

# Pexels - server-only, used for automatic recipe photos
PEXELS_API_KEY=your-pexels-api-key

# Resend - server-only, used for member invitation and auth emails
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Home Cooked <noreply@send.your-domain.com>"

# Supabase Send Email hook secret — Authentication → Hooks → Send Email.
# Without it, /api/auth/send-email returns 500 and no sign-in codes go out.
SEND_EMAIL_HOOK_SECRET=v1,whsec_your-hook-secret

# Optional admin access list
ADMIN_EMAILS=you@example.com

# Admin Web Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional paid fallback provider. Leave unset to avoid OpenAI charges.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_RECIPE_MODEL=gpt-5-mini
# OPENAI_RECIPE_OCR_MODEL=gpt-4.1-mini
# ANTHROPIC_RECIPE_MODEL=claude-haiku-4-5-20251001
